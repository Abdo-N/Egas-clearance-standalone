{
  "name": "egas-clearance-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:dev": "node src/seed/seed.js",
    "seed:final": "node src/seed/seedDepartments.js",
    "seed:final:reset-users": "node src/seed/seedDepartments.js --reset-users",
    "seed:local": "(docker start egas-postgres 2>/dev/null || docker run -d --name egas-postgres -p 5432:5432 -e POSTGRES_PASSWORD=postgres -v egas-postgres-data:/var/lib/postgresql/data postgres:16) && DATABASE_URL=postgres://postgres:postgres@localhost:5432/egas_clearance node src/seed/seed.js"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "pngjs": "^7.0.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
